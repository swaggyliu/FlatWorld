# Copy to deploy/local.env (gitignored) and fill in privately.
# Never commit real hosts, users, or key paths.

PUSHT_SSH_HOST=YOUR_ECS_PUBLIC_IP
PUSHT_SSH_USER=YOUR_SSH_USER
PUSHT_SSH_KEY=C:/path/to/private_key
PUSHT_REMOTE_DIR=/home/YOUR_SSH_USER/flatworld
PUSHT_TLS_HOST=YOUR_ECS_PUBLIC_IP.sslip.io
PUSHT_APP_USER=YOUR_SSH_USER
# Optional public WSS after mount_pusht_flexphysics.sh (ICP domain):
# PUSHT_PUBLIC_WSS=wss://www.flexphysics.com/cal/task-data/ws/_fw
